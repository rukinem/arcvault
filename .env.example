# WalletConnect — get a free project id at https://cloud.walletconnect.com
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id

# Address of the deployed USDCStaking contract on Arc Testnet (chainId 5042002).
# Auto-populated after running `npm run deploy`.
NEXT_PUBLIC_STAKING_ADDRESS=0x0000000000000000000000000000000000000000

# Burner-wallet private key used ONLY to deploy the contract from your machine.
# Generate a fresh one (e.g. via MetaMask) and fund it with testnet USDC at
# https://faucet.circle.com — never reuse a wallet that holds real assets.
DEPLOYER_PRIVATE_KEY=
